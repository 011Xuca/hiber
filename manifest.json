{
  "manifest_version": 3,
  "name": "Hiber",
  "version": "2.0.0",
  "default_locale": "es",
  "description": "__MSG_desc__",
  "minimum_chrome_version": "111",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["tabs", "storage", "alarms", "declarativeNetRequest", "system.memory", "privacy"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html", "default_title": "Hiber",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["defaults.js", "content.js"], "run_at": "document_start" },
    { "matches": ["<all_urls>"], "js": ["main.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["*://*.youtube.com/*"], "js": ["yt.js"], "run_at": "document_start", "world": "MAIN" }
  ]
}
